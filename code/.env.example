# ============================================================
# ThinkLab 环境变量示例（复制为 .env 后按需修改；也可直接 export）
# 未配置密钥时系统会自动降级：LLM → 模板模型，向量库 → 本地索引
# ============================================================

# ---------- LLM：DeepSeek（主用）----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-chat（通用对话） / deepseek-reasoner（深度推理）
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.65
# DEEPSEEK_MAX_TOKENS=2048
# auto | deepseek | openai | template
THINKLAB_LLM_MODE=auto
# DeepSeek 调用失败（网络/鉴权/限流）时是否用内置模板模型兜底，保证服务不中断
THINKLAB_LLM_FALLBACK=true

# ---------- Embedding（DeepSeek 不提供 embedding 接口，向量化单独配置）----------
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 仅当 THINKLAB_LLM_MODE=openai 时作为备用 LLM 使用
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.65

# ---------- 向量库（Pinecone） ----------
PINECONE_API_KEY=
PINECONE_INDEX=thinklab-philosophy
PINECONE_NAMESPACE=philosophy-v1
PINECONE_DIMENSION=1536
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# auto | pinecone | local
THINKLAB_VECTORSTORE_MODE=auto

# ---------- 检索 ----------
THINKLAB_RETRIEVAL_TOP_K=4
THINKLAB_RETRIEVAL_CANDIDATE_K=16

# ---------- 多轮记忆 ----------
THINKLAB_MEMORY_WINDOW_TURNS=6
THINKLAB_MEMORY_COMPRESS_TURNS=8

# ---------- 数据库（PostgreSQL） ----------
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/thinklab
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=thinklab
# auto | postgres | sqlite（auto 在 PostgreSQL 不可用时降级 SQLite 便于本地演示）
THINKLAB_DB_MODE=auto

# ---------- 服务 ----------
THINKLAB_CORS_ORIGINS=*
AGENT_API_BASE=http://127.0.0.1:8000
PORT=4173
VITE_API_BASE=
